/* ==========================================================================
   Final Fantasy MTG Collection Tracker - Stylesheet
   Theme: Deep Slate & Crystal Fantasy (Dark Mode)
   ========================================================================== */

:root {
  --bg-main: #0B0F19;
  --bg-card: #131B2E;
  --bg-card-hover: #1A253E;
  --bg-surface: #1E293B;
  --bg-surface-light: #2D3D58;
  --border-color: #2E3E5B;
  --border-light: #3E5175;

  --text-primary: #F8FAFC;
  --text-secondary: #94A3B8;
  --text-muted: #64748B;
  --text-dim: #475569;

  --accent-cyan: #38BDF8;
  --accent-blue: #3B82F6;
  --accent-indigo: #6366F1;
  --accent-emerald: #10B981;
  --accent-gold: #F59E0B;
  --accent-rose: #F43F5E;
  --accent-purple: #A855F7;
  --accent-amber: #D97706;

  --owned-bg: rgba(16, 185, 129, 0.12);
  --owned-border: #10B981;
  --unowned-bg: rgba(244, 63, 94, 0.06);

  --font-title: 'Cinzel', serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'Fira Code', monospace;

  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.5), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.6), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --shadow-glow: 0 0 20px rgba(56, 189, 248, 0.25);
  --shadow-gold: 0 0 20px rgba(245, 158, 11, 0.25);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-body);
  background-color: var(--bg-main);
  color: var(--text-primary);
  line-height: 1.5;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* --------------------------------------------------------------------------
   App Header
   -------------------------------------------------------------------------- */
.app-header {
  background: linear-gradient(180deg, #10172A 0%, #0B0F19 100%);
  border-bottom: 1px solid var(--border-color);
  padding: 20px 0;
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(12px);
}

.header-container {
  max-width: 1550px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.brand-badge {
  display: inline-block;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--accent-cyan);
  background: rgba(56, 189, 248, 0.12);
  border: 1px solid rgba(56, 189, 248, 0.3);
  padding: 3px 10px;
  border-radius: 20px;
  margin-bottom: 4px;
}

.brand-title {
  font-family: var(--font-title);
  font-size: 24px;
  font-weight: 900;
  letter-spacing: 1px;
  background: linear-gradient(135deg, #FFFFFF 0%, #93C5FD 50%, #38BDF8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.brand-subtitle {
  font-size: 13px;
  color: var(--text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   Buttons
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  text-decoration: none;
}

.btn-outline {
  background: var(--bg-card);
  color: var(--text-primary);
  border-color: var(--border-color);
}

.btn-outline:hover {
  background: var(--bg-surface);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
}

.btn-primary:hover {
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
  box-shadow: 0 0 16px rgba(59, 130, 246, 0.4);
}

.btn-secondary {
  background: var(--bg-surface);
  color: var(--text-secondary);
  border-color: var(--border-color);
}

.btn-secondary:hover {
  background: var(--bg-surface-light);
  color: var(--text-primary);
}

.btn-danger-outline {
  background: rgba(244, 63, 94, 0.1);
  color: #FDA4AF;
  border-color: rgba(244, 63, 94, 0.3);
}

.btn-danger-outline:hover {
  background: var(--accent-rose);
  color: #FFFFFF;
}

.btn-text {
  background: none;
  border: none;
  color: var(--accent-cyan);
  font-size: 12px;
  cursor: pointer;
  text-decoration: underline;
}

.cursor-pointer {
  cursor: pointer;
}

/* --------------------------------------------------------------------------
   Dashboard Section
   -------------------------------------------------------------------------- */
.dashboard-section {
  padding: 24px 0 16px 0;
  background: radial-gradient(circle at 50% 0%, #162036 0%, #0B0F19 70%);
  border-bottom: 1px solid var(--border-color);
}

.dashboard-container {
  max-width: 1550px;
  margin: 0 auto;
  padding: 0 24px;
}

.metric-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.metric-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 18px 20px;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.metric-card:hover {
  transform: translateY(-2px);
  border-color: var(--border-light);
}

.metric-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
}

.card-cyan::before { background: linear-gradient(90deg, #38BDF8, #0284C7); }
.card-emerald::before { background: linear-gradient(90deg, #10B981, #059669); }
.card-blue::before { background: linear-gradient(90deg, #3B82F6, #6366F1); }
.card-gold::before { background: linear-gradient(90deg, #F59E0B, #D97706); }

.metric-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.metric-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--text-secondary);
}

.metric-icon {
  font-size: 16px;
}

.metric-value {
  font-size: 28px;
  font-weight: 800;
  font-family: var(--font-mono);
  color: #FFFFFF;
  margin-bottom: 4px;
}

.metric-sub {
  font-size: 12px;
  color: var(--text-muted);
}

/* Progress Bar */
.progress-bar-container {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 16px 20px;
  margin-bottom: 20px;
}

.progress-bar-label {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 8px;
  color: var(--text-secondary);
}

.progress-track {
  height: 12px;
  background: var(--bg-surface);
  border-radius: 6px;
  overflow: hidden;
  position: relative;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #10B981 0%, #38BDF8 50%, #A855F7 100%);
  border-radius: 6px;
  transition: width 0.5s ease;
  box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
}

/* Game Pills */
.games-breakdown-wrapper {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 14px 18px;
}

.games-breakdown-title {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1px;
  color: var(--text-secondary);
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.games-pills-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 6px;
}

.games-pills-row::-webkit-scrollbar {
  height: 6px;
}
.games-pills-row::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 3px;
}

.game-pill {
  flex-shrink: 0;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 6px 12px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-align: center;
}

.game-pill:hover {
  border-color: var(--accent-cyan);
  background: var(--bg-surface-light);
}

.game-pill.active {
  background: rgba(56, 189, 248, 0.15);
  border-color: var(--accent-cyan);
  box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
}

.game-pill-name {
  font-size: 12px;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
}

.game-pill-stat {
  font-size: 10px;
  color: var(--text-muted);
  font-family: var(--font-mono);
}

.game-pill-pct {
  color: var(--accent-cyan);
  font-weight: 600;
}

/* --------------------------------------------------------------------------
   Controls & Filters Section
   -------------------------------------------------------------------------- */
.controls-section {
  padding: 20px 0 12px 0;
  border-bottom: 1px solid var(--border-color);
}

.controls-container {
  max-width: 1550px;
  margin: 0 auto;
  padding: 0 24px;
}

.search-sort-bar {
  display: flex;
  gap: 16px;
  margin-bottom: 16px;
  flex-wrap: wrap;
}

.search-box {
  flex: 1;
  min-width: 320px;
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 14px;
  font-size: 14px;
  color: var(--text-muted);
}

.search-box input {
  width: 100%;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 12px 40px 12px 38px;
  color: var(--text-primary);
  font-size: 14px;
  font-family: var(--font-body);
  transition: all 0.2s ease;
}

.search-box input:focus {
  outline: none;
  border-color: var(--accent-cyan);
  box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
}

.search-clear {
  position: absolute;
  right: 12px;
  background: none;
  border: none;
  color: var(--text-muted);
  font-size: 14px;
  cursor: pointer;
}

.sort-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.sort-box label {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary);
  white-space: nowrap;
}

.sort-box select,
.filter-group select {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-family: var(--font-body);
  cursor: pointer;
  transition: border-color 0.2s ease;
}

.sort-box select:focus,
.filter-group select:focus {
  outline: none;
  border-color: var(--accent-cyan);
}

.filters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
  align-items: flex-end;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.filter-group label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.filter-group select {
  width: 100%;
}

.filter-reset-group {
  display: flex;
  justify-content: flex-end;
}

.filter-reset-group .btn {
  height: 42px;
  width: 100%;
  justify-content: center;
}

.results-meta-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-top: 1px solid rgba(46, 62, 91, 0.5);
  font-size: 13px;
  color: var(--text-secondary);
}

.results-count strong {
  color: var(--text-primary);
}

/* --------------------------------------------------------------------------
   Cards Display Section
   -------------------------------------------------------------------------- */
.cards-section {
  padding: 24px 0 60px 0;
}

.cards-container {
  max-width: 1550px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Visual Binder Grid Mode */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 22px;
  margin-bottom: 30px;
}

.card-item {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  position: relative;
}

.card-item:hover {
  transform: translateY(-4px);
  border-color: var(--accent-cyan);
  box-shadow: 0 12px 24px -6px rgba(0, 0, 0, 0.7), 0 0 16px rgba(56, 189, 248, 0.2);
}

.card-item.is-owned {
  border-color: rgba(16, 185, 129, 0.6);
  background: linear-gradient(180deg, rgba(16, 185, 129, 0.1) 0%, var(--bg-card) 60%);
}

.card-item-badge-owned {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #10B981;
  color: #FFFFFF;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.5px;
  padding: 3px 8px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(16, 185, 129, 0.4);
  z-index: 5;
}

.card-media-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 5/7;
  background: #060911;
  overflow: hidden;
  cursor: pointer;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
}

.card-media-wrapper:hover .card-image {
  transform: scale(1.04);
}

.card-pill-tags {
  position: absolute;
  bottom: 8px;
  left: 8px;
  right: 8px;
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  z-index: 4;
}

.tag-badge {
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 4px;
  backdrop-filter: blur(8px);
  text-transform: uppercase;
}

.tag-game { background: rgba(15, 23, 42, 0.85); color: #38BDF8; border: 1px solid rgba(56, 189, 248, 0.3); }
.tag-set { background: rgba(15, 23, 42, 0.85); color: #F8FAFC; border: 1px solid #475569; }
.tag-rarity-mythic { background: rgba(220, 38, 38, 0.85); color: #FEF2F2; }
.tag-rarity-rare { background: rgba(217, 119, 6, 0.85); color: #FFFBEB; }
.tag-rarity-uncommon { background: rgba(71, 85, 105, 0.85); color: #F1F5F9; }
.tag-rarity-common { background: rgba(15, 23, 42, 0.85); color: #94A3B8; }
.tag-variant { background: rgba(124, 58, 237, 0.85); color: #EDE9FE; }
.tag-mtg-name {
  font-size: 11px;
  color: #94A3B8;
  background: rgba(30, 41, 59, 0.7);
  border: 1px dashed #475569;
  padding: 2px 6px;
  border-radius: 4px;
  margin-top: 2px;
  display: inline-block;
}

.card-info {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 2px;
}

.card-name {
  font-size: 15px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.3;
}

.card-collector {
  font-size: 11px;
  font-family: var(--font-mono);
  color: var(--text-muted);
}

.card-mtg-subtitle {
  font-size: 11px;
  color: #93C5FD;
  font-style: italic;
  margin-bottom: 4px;
}

.card-type {
  font-size: 12px;
  color: var(--text-secondary);
  margin-bottom: 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-price-row {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  padding: 6px 10px;
  background: var(--bg-surface);
  border-radius: 6px;
  margin-bottom: 12px;
  font-family: var(--font-mono);
}

.price-item {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 9px;
  text-transform: uppercase;
  color: var(--text-muted);
}

.price-val {
  font-weight: 700;
  color: var(--text-primary);
}

.price-foil {
  color: var(--accent-gold);
}

/* Variant Quick Hub on Card Item */
.card-variants-hub {
  background: rgba(11, 15, 25, 0.6);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 8px 10px;
  margin-bottom: 12px;
}

.variants-hub-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: var(--text-secondary);
  margin-bottom: 6px;
  display: flex;
  justify-content: space-between;
}

.variant-chips-grid {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.variant-chip {
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 4px 8px;
  font-size: 11px;
  font-weight: 600;
  color: var(--text-secondary);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: all 0.15s ease;
  user-select: none;
}

.variant-chip:hover {
  border-color: var(--accent-cyan);
  color: var(--text-primary);
}

.variant-chip.active-nonfoil {
  background: rgba(16, 185, 129, 0.15);
  border-color: #10B981;
  color: #34D399;
}

.variant-chip.active-foil {
  background: rgba(245, 158, 11, 0.15);
  border-color: #F59E0B;
  color: #FBBF24;
}

.variant-chip.active-surge {
  background: rgba(56, 189, 248, 0.15);
  border-color: #38BDF8;
  color: #7DD3FC;
}

.variant-chip.active-wave {
  background: rgba(168, 85, 247, 0.15);
  border-color: #A855F7;
  color: #C084FC;
}

.variant-chip.active-promo {
  background: rgba(236, 72, 153, 0.15);
  border-color: #EC4899;
  color: #F472B6;
}

.variant-chip.active-serialized {
  background: rgba(234, 179, 8, 0.2);
  border-color: #EAB308;
  color: #FEF08A;
  box-shadow: 0 0 8px rgba(234, 179, 8, 0.3);
}

.chip-count {
  font-family: var(--font-mono);
  font-weight: 800;
  font-size: 11px;
}

/* Card Ownership Controls */
.card-actions-row {
  margin-top: auto;
  display: flex;
  gap: 8px;
  align-items: center;
}

.btn-open-modal {
  flex: 1;
  padding: 8px;
  font-size: 12px;
  font-weight: 700;
  border-radius: 6px;
  border: 1px solid var(--border-color);
  background: var(--bg-surface);
  color: var(--text-primary);
  cursor: pointer;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}

.btn-open-modal:hover {
  background: var(--bg-surface-light);
  border-color: var(--accent-cyan);
}

/* --------------------------------------------------------------------------
   Spreadsheet Table View
   -------------------------------------------------------------------------- */
.table-wrapper {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow-x: auto;
  margin-bottom: 30px;
}

.tracker-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
  text-align: left;
}

.tracker-table thead {
  background: #1E293B;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tracker-table th {
  padding: 12px 14px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: #FFFFFF;
  border-bottom: 2px solid var(--border-color);
  white-space: nowrap;
}

.tracker-table td {
  padding: 8px 12px;
  border-bottom: 1px solid var(--border-color);
  vertical-align: middle;
}

.tracker-table tbody tr {
  transition: background 0.15s ease;
}

.tracker-table tbody tr:hover {
  background: var(--bg-surface);
}

.tracker-table tbody tr.row-owned {
  background: var(--owned-bg);
}

.tracker-table tbody tr.row-owned:hover {
  background: rgba(16, 185, 129, 0.2);
}

.table-thumb {
  width: 44px;
  height: 60px;
  object-fit: cover;
  border-radius: 4px;
  cursor: pointer;
  transition: transform 0.2s ease;
  background: #060911;
}

.table-thumb:hover {
  transform: scale(2.2);
  z-index: 20;
  box-shadow: var(--shadow-lg);
}

.table-select,
.table-input {
  background: var(--bg-main);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 6px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-family: var(--font-body);
}

.table-select:focus,
.table-input:focus {
  outline: none;
  border-color: var(--accent-cyan);
}

.table-qty-input {
  width: 55px;
  text-align: center;
  font-family: var(--font-mono);
  font-weight: 700;
}

.table-variants-badges {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

/* --------------------------------------------------------------------------
   Pagination Controls
   -------------------------------------------------------------------------- */
.results-pagination,
.bottom-pagination {
  display: flex;
  gap: 6px;
  align-items: center;
  justify-content: center;
}

.page-btn {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  min-width: 34px;
  height: 34px;
  padding: 0 10px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.page-btn:hover:not(:disabled) {
  background: var(--bg-surface);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
}

.page-btn.active {
  background: var(--accent-blue);
  border-color: var(--accent-blue);
  color: #FFFFFF;
}

.page-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* --------------------------------------------------------------------------
   Card Detail / Variant Manager Modal
   -------------------------------------------------------------------------- */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 1000;
}

.modal-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  max-width: 960px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
  box-shadow: var(--shadow-lg), var(--shadow-glow);
}

.modal-close-btn {
  position: absolute;
  top: 16px;
  right: 16px;
  background: var(--bg-surface);
  border: 1px solid var(--border-color);
  color: var(--text-secondary);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  font-size: 20px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  transition: all 0.2s ease;
}

.modal-close-btn:hover {
  background: var(--accent-rose);
  color: #FFFFFF;
  border-color: var(--accent-rose);
}

.modal-body {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 28px;
  padding: 30px;
}

.modal-image-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.modal-image-large {
  width: 100%;
  border-radius: 12px;
  box-shadow: var(--shadow-lg);
}

.modal-details-col {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.modal-title {
  font-size: 22px;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1.2;
}

.modal-mtg-ref {
  font-size: 13px;
  color: #93C5FD;
  font-style: italic;
  margin-top: 2px;
}

.modal-type {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: 4px;
}

.modal-oracle-box {
  background: var(--bg-main);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 12px 14px;
  font-size: 13px;
  line-height: 1.6;
  white-space: pre-wrap;
}

.modal-flavor-box {
  font-size: 12px;
  font-style: italic;
  color: var(--text-muted);
  line-height: 1.5;
  border-left: 3px solid var(--accent-cyan);
  padding-left: 10px;
}

.modal-meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  font-size: 12px;
  background: var(--bg-surface);
  padding: 12px;
  border-radius: 8px;
}

.modal-meta-item strong {
  color: var(--text-secondary);
  margin-right: 4px;
}

/* Modal Variant Inventory Table */
.modal-variant-inventory {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  padding: 14px;
}

.modal-variant-inventory-title {
  font-size: 13px;
  font-weight: 800;
  color: var(--accent-cyan);
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.variant-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}

.variant-table th {
  padding: 6px 8px;
  color: var(--text-secondary);
  font-size: 10px;
  text-transform: uppercase;
  border-bottom: 1px solid var(--border-color);
}

.variant-table td {
  padding: 8px;
  border-bottom: 1px solid rgba(46, 62, 91, 0.4);
  vertical-align: middle;
}

.stepper-control {
  display: inline-flex;
  align-items: center;
  background: var(--bg-main);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  overflow: hidden;
}

.stepper-btn {
  background: none;
  border: none;
  color: var(--text-secondary);
  width: 26px;
  height: 28px;
  font-size: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-btn:hover {
  background: var(--bg-surface);
  color: var(--text-primary);
}

.stepper-val {
  width: 32px;
  text-align: center;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--text-primary);
}

/* --------------------------------------------------------------------------
   Empty State & Toast
   -------------------------------------------------------------------------- */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  background: var(--bg-card);
  border: 1px dashed var(--border-color);
  border-radius: 12px;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-state h3 {
  font-size: 18px;
  margin-bottom: 6px;
}

.empty-state p {
  color: var(--text-muted);
  margin-bottom: 18px;
}

.toast {
  position: fixed;
  bottom: 24px;
  right: 24px;
  background: #10B981;
  color: #FFFFFF;
  font-size: 13px;
  font-weight: 700;
  padding: 12px 20px;
  border-radius: 8px;
  box-shadow: var(--shadow-lg);
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.25s ease;
  z-index: 2000;
  pointer-events: none;
}

.toast.show {
  opacity: 1;
  transform: translateY(0);
}

/* --------------------------------------------------------------------------
   Responsive Layout
   -------------------------------------------------------------------------- */
@media (max-width: 900px) {
  .modal-body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .header-container {
    flex-direction: column;
    align-items: flex-start;
  }
  .cards-grid {
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }
  .metric-cards-grid {
    grid-template-columns: 1fr 1fr;
  }
}
